# Copia este archivo como .env y completa los valores.

# ---------- General ----------
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
ADMIN_PASSWORD=admin123
BUSINESS_NAME=Filtra tu Placa

# ---------- Base de datos ----------
# Vacío = SQLite local (crm_local.db). Para Supabase pega la URI del "Session pooler":
# Supabase > Project Settings > Database > Connection string > Session pooler
# DATABASE_URL=postgresql://postgres.xxxxxxxx:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# ---------- WhatsApp Cloud API ----------
# simulator = no llama a Meta (para probar).  cloud = envía mensajes reales.
WA_MODE=simulator
# developers.facebook.com > Tu app > WhatsApp > Configuración de la API
WA_TOKEN=
WA_PHONE_NUMBER_ID=
# Un texto que tú inventas; el mismo lo pones en Meta al configurar el webhook
WA_VERIFY_TOKEN=mi_token_de_verificacion
# Tu app > Configuración > Básica > Clave secreta de la app (valida que el webhook viene de Meta)
WA_APP_SECRET=
WA_API_VERSION=v23.0

# URL pública del servidor (ej. https://crm-whatsapp.onrender.com). Necesaria si usas imágenes en /static
PUBLIC_BASE_URL=

# ---------- Biblioteca de imágenes (Supabase Storage) ----------
# Sin esto, las imágenes se guardan en crm/static/uploads (en Render se BORRAN al reiniciar).
# Supabase > Project Settings > API: Project URL y la clave secreta (service_role / sb_secret_...)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=media

# ---------- Seguimientos ----------
RUN_SCHEDULER=true
SCHEDULER_INTERVAL=15
# Token para /cron/tick?token=... (UptimeRobot)
CRON_TOKEN=
